#!/bin/bash

#------------------------------------------------------------------------------------
# Name:          silo-builder
# Description:   This script builds and optionally packages the Silo application for distribution.
#                At a minimum, it builds the Silo binary and bundles the necessary dependencies, 
#                Then where applicable, it packages the application and creates a zip file for distribution.
# Author :       Giles Thompson
# Date:          09-10-2026
#
# Usage:  From the project ROOT run:        
#         sudo ./silo-builder -o <output_directory> -i <images_path>
#------------------------------------------------------------------------------------





echo "Building Silo, standby..."

#Global variables
VERSION="1.0.0"
IMAGES_PATH=""
OUTPUT_DIR=""
PACKAGE=false
DEFAULT_SILO_BASE_IMAGE_URL="" # will hold the resolved default silo base image URL for the current system's CPU architecture, which is resolved later in the script.
DEFAULT_SILO_BASE_IMAGE_CHECKSUM="" # will hold the resolved default silo base image checksum for the current system's CPU architecture, which is resolved later in the script.
DEFAULT_SILO_BASE_IMAGE_DISTRO="" # will hold the resolved default silo base image distro for the current system's CPU architecture, which is resolved later in the script.
DEFAULT_SILO_BASE_IMAGE_VERSION="" # will hold the resolved default silo base image version for the current system's CPU architecture, which is resolved later in the script.
DEFAULT_SILO_BASE_IMAGE_ARCH="" # will hold the resolved default silo base image architecture for the current system's CPU architecture, which is resolved later in the script.
STANDARD__USER="${SUDO_USER:-$(id -un)}"  # as the script is run with sudo, this will be the user that invoked sudo.


# cleanup to always run on exit, regardless of success or failure
cleanup() {
    local status=$?
    trap - EXIT ERR

    echo "Cleaning up..."
    rm -rf silo-images
    rm -f silo-image-catalogue.json

    exit $status
}

# ensure cleanup is called on exit or error
trap cleanup EXIT
trap 'exit $?' ERR



# Resolves the default base image for the system's CPU architecture, to do this
# it implicitly:
# 1. Determines the system's CPU architecture (amd64 or arm64)
# 2. Pulls down the silo-images repository to access the base image catalogue JSON file
# 3. Parses the default base image for the architecture from the catalogue
# 4. Retuens the URL that points to the default base image for the architecture, 
#    or an error if the architecture is unsupported or the catalogue cannot be accessed.
resolveDefaultBaseImageURLForArchitecture() {
 
    # query the system's CPU architecture
    local arch
    arch=$(getSystemCPUArchitecture)

    # pulls down the silo-images repository to access the base image catalogue JSON file
    # and places it in the current directory
    acquireSiloBaseImageCatalogueFileFromSiloImagesRepo || { echo "Error: Failed to acquire base image catalogue from silo-images repository." >&2; return 1; }
    local catalogue_file="./silo-image-catalogue.json"

    
    local default_base_image_url_for_arch
    local default_base_image_checksum_for_arch
    case "$arch" in
        "amd64")
            default_base_image_url_for_arch=$(parseDefaultBaseImageFromCatalogue "$arch" "$catalogue_file")
            default_base_image_checksum_for_arch=$(parseDefaultBaseImageChecksumFromCatalogue "$arch" "$catalogue_file")
            ;;
        "arm64")
            default_base_image_url_for_arch=$(parseDefaultBaseImageFromCatalogue "$arch" "$catalogue_file")
            default_base_image_checksum_for_arch=$(parseDefaultBaseImageChecksumFromCatalogue "$arch" "$catalogue_file")
            ;;
        *)
            echo "Error: Unsupported architecture '$arch'. Supported architectures are 'amd64' and 'arm64'." >&2
            return 1
            ;;
    esac
    
    # return image URL and checksum for the architecture, which will be stored in global variables for later use.
    DEFAULT_SILO_BASE_IMAGE_URL="$default_base_image_url_for_arch"
    DEFAULT_SILO_BASE_IMAGE_CHECKSUM="$default_base_image_checksum_for_arch"    
    #echo "$default_base_image_url_for_arch"
}

# downloads default silo base image at the specified URL for the current system's 
# CPU architecture, and saves it to the current directory. 
# Note: the function implicitly takes care of calculating and verifying the SHA256 checksum of the downloaded base image 
# against the expected checksum as defined in the base image catalogue.
downloadDefaultSiloBaseImageForArchitecture() {
    local image_url="$1"
    local image_arch="$(getSystemCPUArchitecture)"

    if [[ -z "$image_url" ]]; then
        echo "Error: Image URL not provided." >&2
        return 1
    fi

    # make temp directory for the base image download using mktemp to avoid conflicts with existing files and ensure a clean environment.
    baseImagesTemp=$(mktemp -d "${TMPDIR:-/tmp}/silo-base-image.XXXXXX" || { echo "Error: Failed to create temporary directory for base image download." >&2; return 1; })
     
    # download the base image to the temp directory, using wget.
    wget -O "$baseImagesTemp/silo-base-image.tar.gz" "$image_url" || { echo "Error: Failed to download base image from URL '$image_url'." >&2; return 1; }

     # call SHA256 checksum of the downloaded base image tar.gz file and compare it to the expected checksum for the architecture, which is stored in a global variable.
    local downloaded_checksum
    downloaded_checksum=$(sha256sum "$baseImagesTemp/silo-base-image.tar.gz" | awk '{print $1}')
    if [[ "$downloaded_checksum" != "$DEFAULT_SILO_BASE_IMAGE_CHECKSUM" ]]; then
        echo "Error: Checksum verification failed for downloaded base image. Expected: $DEFAULT_SILO_BASE_IMAGE_CHECKSUM, Got: $downloaded_checksum" >&2
        return 1
    fi
    
    # build image release path directory.
    fullImageReleaseDir="$releaseDir/res/silo-images/$image_arch/$DEFAULT_SILO_BASE_IMAGE_DISTRO-$DEFAULT_SILO_BASE_IMAGE_VERSION--$image_arch-release"
    mkdir -p "$fullImageReleaseDir" || { echo "Error: Failed to create release directory '$fullImageReleaseDir'." >&2; return 1; }

    # extract the downloaded base image tar.gz file to the release directory. 
    tar -xzf "$baseImagesTemp/silo-base-image.tar.gz" -C "$fullImageReleaseDir" || { echo "Error: Failed to extract base image to release directory." >&2; return 1; }   

    # clean up the temporary directory used for the base image download.
    rm -rf "$baseImagesTemp" || { echo "Error: Failed to clean up temporary directory '$baseImagesTemp'." >&2; return 1; }
}

 parseDefaultBaseImageMetadataFromCatalogue() {
    local arch="$1"
    local catalogue_file="$2"

    if [[ ! -f "$catalogue_file" ]]; then
        echo "Error: Base image catalogue file '$catalogue_file' not found." >&2
        return 1
    fi

    # parse the default base image object for the specified architecture from the catalogue JSON file.
    local default_base_image
    default_base_image=$(jq --arg arch "$arch" \
    '.[if $arch == "arm64" then "defaultArm64Image" else "defaultAmd64Image" end]' \
     "$catalogue_file")

    # where we've failed to find a default base image for the architecture, return an error.
    if [[ -z "$default_base_image" || "$default_base_image" == "null" ]]; then
        echo "Error: Default base image for architecture '$arch' not found in catalogue." >&2
        return 1
    fi

    # next store each of the properties of the default base image object into variables for later use.
    DEFAULT_SILO_BASE_IMAGE_DISTRO=$(echo "$default_base_image" | jq -r '.distro')
    DEFAULT_SILO_BASE_IMAGE_VERSION=$(echo "$default_base_image" | jq -r '.version')
    DEFAULT_SILO_BASE_IMAGE_ARCH="$arch"

 }


parseDefaultBaseImageFromCatalogue() {
    local arch="$1"
    local catalogue_file="$2"

    if [[ ! -f "$catalogue_file" ]]; then
        echo "Error: Base image catalogue file '$catalogue_file' not found." >&2
        return 1
    fi

    # parse the default base image object for the specified archotecture from the catalogue JSON file.
    # which is expected to be an object that looks as follows:
    # {"distro": "ubuntu", "version": "25.04", "release_version": "1792376224294092687"}
    local default_base_image
    default_base_image=$(jq --arg arch "$arch" \
    '.[if $arch == "arm64" then "defaultArm64Image" else "defaultAmd64Image" end]' \
     "$catalogue_file")

    # where we've failed to find a default base image for the architecture, return an error.
    if [[ -z "$default_base_image" || "$default_base_image" == "null" ]]; then
        echo "Error: Default base image for architecture '$arch' not found in catalogue." >&2
        return 1
    fi

    # next store each of the properties of the default base image object into variables for later use.
    local distro
    local version
    local release_version
    distro=$(echo "$default_base_image" | jq -r '.distro')
    version=$(echo "$default_base_image" | jq -r '.version')
    release_version=$(echo "$default_base_image" | jq -r '.release_version')
   

    # finally iterate through the  silo-images[$arch] array to find the matching base image object and return its URL.
    local base_image_url
    base_image_url=$(jq -r --arg arch "$arch" --arg distro "$distro" --arg version "$version" --arg release_version "$release_version" \
    '.["silo-images"][$arch][] | select(.distro == $distro and .version == $version and .release_version == $release_version) | .image_url' \
    "$catalogue_file")

    # if we failed to find a mathcing base image object and/or its URL, return an error.
    if [[ -z "$base_image_url" || "$base_image_url" == "null" ]]; then
        echo "Error: Matching default base image for architecture '$arch' not found in catalogue." >&2
        return 1
    fi
   
    
    echo "$base_image_url"
}

parseDefaultBaseImageChecksumFromCatalogue() {
    local arch="$1"
    local catalogue_file="$2"

    if [[ ! -f "$catalogue_file" ]]; then
        echo "Error: Base image catalogue file '$catalogue_file' not found." >&2
        return 1
    fi

    # parse the default base image object for the specified architecture from the catalogue JSON file.
    local default_base_image
    default_base_image=$(jq --arg arch "$arch" \
    '.[if $arch == "arm64" then "defaultArm64Image" else "defaultAmd64Image" end]' \
     "$catalogue_file")

    # where we've failed to find a default base image for the architecture, return an error.
    if [[ -z "$default_base_image" || "$default_base_image" == "null" ]]; then
        echo "Error: Default base image for architecture '$arch' not found in catalogue." >&2
        return 1
    fi

    # next store each of the properties of the default base image object into variables for later use.
    local distro
    local version
    local release_version
    distro=$(echo "$default_base_image" | jq -r '.distro')
    version=$(echo "$default_base_image" | jq -r '.version')
    release_version=$(echo "$default_base_image" | jq -r '.release_version')

    # finally iterate through the silo-images[$arch] array to find the matching base image object and return its checksum.
    local base_image_checksum
    base_image_checksum=$(jq -r --arg arch "$arch" --arg distro "$distro" --arg version "$version" --arg release_version "$release_version" \
    '.["silo-images"][$arch][] | select(.distro == $distro and .version == $version and .release_version == $release_version) | .release_checksum' \
    "$catalogue_file")

     # if we failed to find a matching base image object and/or its checksum, return an error.
    if [[ -z "$base_image_checksum" || "$base_image_checksum" == "null" ]]; then
        echo "Error: Matching default base image for architecture '$arch' not found in catalogue." >&2
        return 1
    fi

    echo "$base_image_checksum"
}


# returns the system's CPU architecture i.e. amd64 or arm64, or 
# an error if the architecture is unsupported.
getSystemCPUArchitecture() {
    local arch
    arch=$(uname -m)

    case "$arch" in
        "x86_64")
            echo "amd64"
            ;;
        "aarch64")
            echo "arm64"
            ;;
        *)
            echo "Error: Unsupported architecture '$arch'. Supported architectures are 'amd64' and 'arm64'." >&2
            return 1
            ;;
    esac
}   

# acquires the base image catalogue JSON file from the silo-images repository.
# and places it in the current directory.
acquireSiloBaseImageCatalogueFileFromSiloImagesRepo() {
    echo "Acquiring Silo base image catalogue..."

     # clone the silo-images repository to access the base image catalogue JSON file
     if ! sudo -u "$STANDARD__USER" git clone --depth 1 \
        https://github.com/silo-engine/silo-images.git ; then
        echo "Error: Failed to clone silo-images repository." >&2
        return 1
    fi

    # Copy the base image catalogue JSON file to the current directory
    cp silo-images/silo-image-catalogue.json . || { echo "Error: Failed to copy base image catalogue." >&2; return 1; }

     # Remove the silo-images directory after copying the base image catalogue
    rm -rf silo-images
}

# parse command line arguments, where:
# -o|--output specifies the output directory for the final zip file
# -i|--images specifies the path to the images to be included in the release package
# -p|--package indicates that a release package should be created (zip file)
while [[ $# -gt 0 ]]; do
    case $1 in
        -o|--output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -i|--images)
            IMAGES_PATH="$2"
            shift 2
            ;;
        -p|--package)
            PACKAGE=true
            shift
            ;;
        *)
            echo "Unknown option $1"
            exit 1
            ;;
    esac
done

# verify that an output directory was provided
if [[ -z "$OUTPUT_DIR" ]]; then
    echo "Error: Output directory not specified. Use -o or --output to specify the output directory."
    exit 1
fi

# verify that an images path was provided
if [[ -z "$IMAGES_PATH" ]]; then
    echo "Error: Images path not specified. Use -i or --images to specify the images path."
    exit 1
fi

# ensure the output target exists before moving files into it
mkdir -p "$OUTPUT_DIR" || { echo "Error: Failed to create output directory"; exit 1; }

# switch to cmd directory and build the Silo binary
echo "Building Silo binary..."
priorDir=$(pwd)
cd cmd/silo || { echo "Error: Failed to change directory to cmd"; exit 1; }
go build -o silo || { echo "Error: Failed to build Silo binary"; exit 1; }
cd "$priorDir"

# create a temporary staging directory so we never zip a directory that already exists
# in the repository root or in the output directory.
releaseRoot=$(mktemp -d "${TMPDIR:-/tmp}/silo-builder.XXXXXX") || { echo "Error: Failed to create temporary staging directory"; exit 1; }
releaseDir="$releaseRoot/Silo-$VERSION"
mkdir -p "$releaseDir" || { echo "Error: Failed to create release directory"; exit 1; }

# move built binary into the release directory
echo "Creating release directory..."
mv cmd/silo/silo "$releaseDir/" || { echo "Error: Failed to move Silo binary to release directory"; exit 1; }

# next resolve the default base image for the system's CPU architecture and store it to a variable for later use.
echo "Resolving URL of default base image for current system architecture..."
resolveDefaultBaseImageURLForArchitecture || { echo "Error: Failed to resolve default base image URL for system architecture"; exit 1; }

# move the base image catalogue JSON file into the release directory, at the catalogue subdirectory, so that it is included in the release package.
# we use the plural "catalogues" in the path to allow for future expansion of silo  to include reference to multiple image catalogues including custom org specific catalogues.
baseSiloImageCataloguesDir="$releaseDir/res/silo-images/catalogues"
mkdir -p "$baseSiloImageCataloguesDir" || { echo "Error: Failed to create base image release directory"; exit 1; }
cp silo-image-catalogue.json "$baseSiloImageCataloguesDir/" || { echo "Error: Failed to copy base image catalogue to release directory"; exit 1; }


echo "Default base image URL for current system architecture: $DEFAULT_SILO_BASE_IMAGE_URL"
echo "Default base image checksum for current system architecture: $DEFAULT_SILO_BASE_IMAGE_CHECKSUM"
cpuArchitecture=$(getSystemCPUArchitecture) || { echo "Error: Failed to determine system CPU architecture"; exit 1; }
parseDefaultBaseImageMetadataFromCatalogue "$cpuArchitecture" "silo-image-catalogue.json" || { echo "Error: Failed to parse default base image metadata from catalogue"; exit 1; }
echo "Default base image distro for current system architecture: $DEFAULT_SILO_BASE_IMAGE_DISTRO"
echo "Default base image version for current system architecture: $DEFAULT_SILO_BASE_IMAGE_VERSION"
echo "Default base image architecture for current system architecture: $DEFAULT_SILO_BASE_IMAGE_ARCH"

# download the default silo base image for the current system's CPU architecture and save it to the release directory.
echo "Downloading default base image for current system architecture..."
downloadDefaultSiloBaseImageForArchitecture "$DEFAULT_SILO_BASE_IMAGE_URL" || { echo "Error: Failed to download default base image for system architecture"; exit 1; }



# zip up the release directory from its parent so all paths are relative and the archive
# file itself is never accidentally considered part of the input tree.
if [ "$PACKAGE" = true ]; then
    echo "Packaging release..."
    (
        cd "$releaseRoot" &&
        zip -ry "Silo-$VERSION.zip" "./Silo-$VERSION"
    ) || {
        echo "Error: Failed to zip release directory"
        exit 1
    }

    # move the zip file to the output directory
    echo "Moving release package to output directory..."
    rm -rf "$OUTPUT_DIR"  || { echo "Error: Failed to clean output directory"; exit 1; }
    mkdir -p "$OUTPUT_DIR" || { echo "Error: Failed to clean output directory"; exit 1; }
    mv "$releaseRoot/Silo-$VERSION.zip" "$OUTPUT_DIR/" || { echo "Error: Failed to move zip file to output directory"; exit 1; }
else
    
    echo "Packaging skipped. Moving release directory to output directory..."
    rm -rf "$OUTPUT_DIR"  || { echo "Error: Failed to clean output directory"; exit 1; }
    mkdir -p "$OUTPUT_DIR" || { echo "Error: Failed to clean output directory"; exit 1; }
    mv "$releaseDir" "$OUTPUT_DIR/" || { echo "Error: Failed to move release directory to output directory"; exit 1; }
fi

# clean up the temporary staging directory
echo "Cleaning up..."
rm -rf "$releaseRoot"

echo "Packaging complete. The Silo release package is located at $OUTPUT_DIR/Silo-$VERSION.zip"


